.git
**/.git
# Private environment files at any depth; preserve the reviewed root example.
.env*
**/.env*
**/*.env
**/*.env.*
!.env.example
# Runtime Compose overlays are not production image inputs.
compose*.yaml
compose*.yml
docker-compose*.yaml
docker-compose*.yml
!compose.example.yaml

# Runtime state, database copies and backups (not SQL migration sources).
**/data
**/uploads
**/logs
**/backups
**/dumps
**/pgdata
**/.pgdata
**/postgres-data
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite-*
**/*.sqlite3
**/*.sqlite3-*
**/*.pgdump
**/*.dump
**/*.dump.*
**/*.sql.gz
**/*.sql.bz2
**/*.sql.xz
**/*.sql.zst
dump*.sql
freeman-*.sql
**/*.backup
**/*.backup.*
**/*.bak
**/*.bak.*
**/*.partial
**/*.fernet
**/*.log
**/*.pid
**/*.sock
**/*.tmp

# Local credentials and private key stores.
**/.netrc
**/.pgpass
**/.pypirc
**/.npmrc
**/.git-credentials
**/.aws
**/.ssh
**/.docker
**/.kube
**/credentials
**/secrets
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore

# Developer and verification output.
**/.venv*
**/audit
**/artifacts
**/__pycache__
**/*.pyc
**/._*
**/.DS_Store
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache
**/.cache
**/node_modules

# Shipped device reference data used by the web application.
!/app/web/data/
/app/web/data/**
!/app/web/data/DeviceKit-LICENSE.txt
!/app/web/data/device-models-sources.json
!/app/web/data/device-models.json
